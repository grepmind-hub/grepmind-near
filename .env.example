# Grepmind Near environment variables
# Copy to .env and fill in values. Never commit real secrets.

# Application
APP_ENV=local
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_REQUEST_ID_HEADER=X-Request-ID

# Database (PostgreSQL + PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_USER=grepmind
DB_PASSWORD=grepmind_dev
DB_NAME=grepmind_near
DB_SSLMODE=disable

# Database migration
DB_MIGRATIONS_PATH=file://migrations

# JWT / sessions
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OTP
OTP_TTL=10m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
# OTP delivery provider (stub in local)
OTP_PROVIDER=stub
OTP_FROM=Grepmind Near

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=grepmind-near
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Firebase Cloud Messaging (stub in local)
FCM_PROJECT_ID=grepmind-near-dev
FCM_CREDENTIALS_PATH=

# Admin
ADMIN_DEFAULT_EMAIL=admin@grepmind.local
ADMIN_DEFAULT_PASSWORD=replace-me

# Rate limiting
RATE_LIMIT_AUTH=5/min
RATE_LIMIT_API=100/min
